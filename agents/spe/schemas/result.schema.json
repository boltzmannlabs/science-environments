{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boltzmann.local/schemas/spe-agent-result.schema.json",
  "title": "SPE agent result",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "environment_id", "execution_status", "evaluation_status", "outputs", "provenance", "limitations", "acceptance_evidence"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "pattern": "^(0[1-9]|1[0-9]|20)$"},
    "execution_status": {"enum": ["completed", "failed", "blocked", "needs-review"]},
    "evaluation_status": {"enum": ["pass", "fail", "needs-review", "not-evaluated"]},
    "outputs": {"type": "object"},
    "acceptance_evidence": {
      "type": "object",
      "additionalProperties": {"type": ["boolean", "null"]}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "engine", "engine_version", "settings", "artifacts"],
      "properties": {
        "adapter": {"type": "string"},
        "engine": {"type": "string"},
        "engine_version": {"type": "string"},
        "settings": {"type": "object"},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "input_digest": {"type": ["string", "null"]}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}, "default": []},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "error": {"type": ["object", "null"]},
    "attempts": {"type": "integer", "minimum": 0, "maximum": 4}
  }
}
