{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boltzmann.local/schemas/spe-agent-task.schema.json",
  "title": "SPE agent task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "environment_id", "objective", "inputs", "requested_outputs"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "environment_id": {"type": "string", "pattern": "^(0[1-9]|1[0-9]|20)$"},
    "objective": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "constraints": {"type": "object", "default": {}},
    "requested_outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "parent_task_id": {"type": ["string", "null"]},
    "artifact_references": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
