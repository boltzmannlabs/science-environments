&GLOBAL
  PROJECT water_b3lyp_631gstar
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME /home/boltzmann15/anaconda3/envs/cp2k_env/share/cp2k/data/EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME /home/boltzmann15/anaconda3/envs/cp2k_env/share/cp2k/data/POTENTIAL
    CHARGE 0
    MULTIPLICITY 1
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPSFIT 1.0E-8
    &END QS
    &MGRID
      CUTOFF 800
      REL_CUTOFF 100
      NGRIDS 5
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END POISSON
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-9
      MAX_SCF 200
    &END SCF
    &XC
      &HF
        FRACTION 0.20
        &SCREENING
          EPS_SCHWARZ 1.0E-12
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL B3LYP
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      UNIT ANGSTROM
      O   0.000000   0.000000   0.000000
      H   0.758602   0.000000   0.504284
      H  -0.758602   0.000000   0.504284
    &END COORD
    &KIND O
      BASIS_SET 6-31Gx
      POTENTIAL ALL
      LEBEDEV_GRID 110
      RADIAL_GRID 100
    &END KIND
    &KIND H
      BASIS_SET 6-31Gx
      POTENTIAL ALL
      LEBEDEV_GRID 110
      RADIAL_GRID 100
    &END KIND
    &TOPOLOGY
      &CENTER_COORDINATES
      &END CENTER_COORDINATES
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
