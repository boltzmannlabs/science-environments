{
  "schema_version": "1.0",
  "tool_id": "synthesis-route-gym",
  "tool_version": "0.1.0",
  "owner_role": "Synthesis and Retrosynthesis pod",
  "source_entrypoint": "synthesis_route_gym.api:create_app",
  "protocol": "HTTP JSON with OpenAPI 3",
  "api_version": "v1",
  "agent_scientist_integration": "../agent_scientist",
  "authentication": "Caller-configured bearer tokens bound to local test owners",
  "persistence": "process-local; one worker; restart loses episodes",
  "endpoints": [
    {
      "method": "GET",
      "path": "/v1/health"
    },
    {
      "method": "GET",
      "path": "/v1/openapi.json"
    },
    {
      "method": "POST",
      "path": "/v1/routes/assess"
    },
    {
      "method": "POST",
      "path": "/v1/conditions/rank"
    },
    {
      "method": "POST",
      "path": "/v1/episodes"
    },
    {
      "method": "GET",
      "path": "/v1/episodes/{episode_id}"
    },
    {
      "method": "POST",
      "path": "/v1/episodes/{episode_id}/actions"
    },
    {
      "method": "DELETE",
      "path": "/v1/episodes/{episode_id}"
    },
    {
      "method": "POST",
      "path": "/v1/handoffs/small-molecule"
    }
  ],
  "acceptance_tests": {
    "command": ".venv/bin/python -m pytest tests/test_api.py tests/test_rebolt_bridge.py -q",
    "covered": [
      "authentication",
      "owner isolation",
      "route assessment",
      "episode lifecycle",
      "budget enforcement",
      "request limits",
      "rate limits",
      "Small Molecule provenance handoff",
      "unknown scientific values",
      "configured-model episode prediction",
      "model-based route ranking",
      "action budget and event trace for model calls",
      "saved REBOLT artifact compatibility"
    ],
    "local_http_command": ".venv/bin/python integrations/platform/verify_local_http.py"
  },
  "scientific_claim_limits": [
    "Deterministic validation does not establish experimental feasibility",
    "Declared evidence requires external curation; the API does not verify citations",
    "No result is marked independently solved by this service",
    "Missing yield and cost remain null",
    "The service does not train or select an LLM"
  ],
  "execution_scope": "local",
  "contract_purpose": "Local API and saved REBOLT artifact compatibility",
  "episode_actions": [
    "inspect",
    "expand",
    "propose_route",
    "validate",
    "predict_conditions",
    "rank_routes",
    "submit"
  ]
}
