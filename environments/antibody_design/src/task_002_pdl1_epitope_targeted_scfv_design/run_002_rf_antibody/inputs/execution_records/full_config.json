  "task_requirements": {
    "objective": "framework-conditioned, epitope-directed design of paired VH/VL candidates (scFv output) against human PD-L1 with H5/35TL as comparator only",
    "constraints": [
      "framework = study trastuzumab scFv (Germinal pdbs/scfv.pdb), VH-first, linker AGGGGSGGGGSGGGS",
      "CDR edit boundaries H1 26-33, H2 51-58, H3 97-109, L1 24-29, L2 50-55, L3 89-97",
      "epitope = 5 hotspots (A37/A39/A41/A96/A98, study numbering) + 4.5 A neighbor shell (28 residues total)",
      "H5 (35TL) held out from generation"
    ],
    "metrics": [
      "H5 reconstruction control: global complex CA RMSD vs 35TL (published AF3 1.25 A)",
      "PD-L1 interface-residue recovery",
      "per-CDR RMSD, ipTM/complex pLDDT"
    ]
  },
