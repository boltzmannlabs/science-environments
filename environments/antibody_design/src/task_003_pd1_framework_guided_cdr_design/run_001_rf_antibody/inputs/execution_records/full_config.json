  "task_requirements": {
    "objective": "Redesign the six CDRs on the fixed paper Table-1 humanized framework (IGHV3-23*01/IGKV1-5*01 + IGHJ4/IGKJ1) against the human PD-1 ligand-binding interface, using the staged 5GGS-derived Fv scaffold, and compare computational evidence with the published anti-PD-1-H965 design.",
    "constraints": [
      "Framework FR blocks byte-identical to Table 1; only the six CDRs editable",
      "CDR lengths H1=7, H2=6, H3=7-18, L1=11, L2=7, L3=9-11",
      "No Cys in CDRs; candidate CDR set must differ from every published panel member",
      "Published panel sequences are comparison controls only, never design inputs",
      "Sequences parsed programmatically from source files, never retyped"
    ],
