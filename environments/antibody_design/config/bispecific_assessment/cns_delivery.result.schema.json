{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/bispecific_assessment/cns_delivery.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "request_sha256",
    "answer",
    "evidence",
    "report",
    "missing_requirements",
    "limitations",
    "validation_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "const": "bispecific_cns_delivery_assessment"
    },
    "status": {
      "enum": [
        "NEEDS_INPUT",
        "INDETERMINATE",
        "ASSESSED"
      ]
    },
    "request_sha256": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/digest"
    },
    "answer": {
      "anyOf": [
        {
          "$ref": "#/$defs/answer"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
      }
    },
    "report": {
      "anyOf": [
        {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "missing_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_scope": {
      "const": "declared_contract_only"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_INPUT"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "type": "null"
          },
          "missing_requirements": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ASSESSED"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "$ref": "#/$defs/answer"
          },
          "evidence": {
            "minItems": 1
          },
          "report": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
          },
          "missing_requirements": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "title": "bispecific_cns_delivery_assessment response envelope",
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_decision",
        "governing_readout",
        "rationale",
        "observations",
        "fold_change",
        "dosing_interval_conclusion",
        "evidence_basis",
        "limitations",
        "missing_followup"
      ],
      "properties": {
        "candidate_decision": {
          "type": "string",
          "minLength": 1
        },
        "governing_readout": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "value",
              "units",
              "replicate_count",
              "timepoint",
              "filters",
              "source"
            ],
            "properties": {
              "candidate_id": {
                "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "units": {
                "type": "string",
                "minLength": 1
              },
              "replicate_count": {
                "type": "integer",
                "minimum": 1
              },
              "timepoint": {
                "type": "string",
                "minLength": 1
              },
              "filters": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
              }
            }
          }
        },
        "fold_change": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "numerator_candidate",
                "denominator_candidate",
                "timepoint"
              ],
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "numerator_candidate": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                },
                "denominator_candidate": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                },
                "timepoint": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "dosing_interval_conclusion": {
          "enum": [
            "SUPPORTED",
            "NOT_SUPPORTED",
            "NEEDS_MORE_EVIDENCE"
          ]
        },
        "evidence_basis": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_followup": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
