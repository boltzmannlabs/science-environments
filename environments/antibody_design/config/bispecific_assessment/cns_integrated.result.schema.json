{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/bispecific_assessment/cns_integrated.result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "status",
    "request_sha256",
    "answer",
    "evidence",
    "report",
    "missing_requirements",
    "limitations",
    "validation_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "const": "bispecific_cns_shuttle_integrated_gate"
    },
    "status": {
      "enum": [
        "NEEDS_INPUT",
        "INDETERMINATE",
        "ASSESSED"
      ]
    },
    "request_sha256": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/digest"
    },
    "answer": {
      "anyOf": [
        {
          "$ref": "#/$defs/answer"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
      }
    },
    "report": {
      "anyOf": [
        {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "missing_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_scope": {
      "const": "declared_contract_only"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NEEDS_INPUT"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "type": "null"
          },
          "missing_requirements": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ASSESSED"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "$ref": "#/$defs/answer"
          },
          "evidence": {
            "minItems": 1
          },
          "report": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
          },
          "missing_requirements": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "title": "bispecific_cns_shuttle_integrated_gate response envelope",
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation",
        "limiting_factor",
        "brain_7d_shuttle1_pct_id_g",
        "brain_7d_shuttle2_pct_id_g",
        "brain_7d_shuttle3_pct_id_g"
      ],
      "properties": {
        "recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recommended_shuttle",
            "dosing_interval_supported"
          ],
          "properties": {
            "recommended_shuttle": {
              "enum": [
                "Shuttle-1",
                "Shuttle-2",
                "Shuttle-3",
                "INDETERMINATE"
              ]
            },
            "dosing_interval_supported": {
              "enum": [
                "WEEKLY",
                "LONGER_THAN_WEEKLY",
                "NOT_SUPPORTED"
              ]
            }
          }
        },
        "limiting_factor": {
          "enum": [
            "NON_RESIDUALIZING_LABEL_BIAS",
            "SMALL_SAMPLE_SIZE_AND_BIOLOGICAL_VARIABILITY",
            "NONE_IDENTIFIED"
          ]
        },
        "brain_7d_shuttle1_pct_id_g": {
          "type": "number",
          "minimum": 0
        },
        "brain_7d_shuttle2_pct_id_g": {
          "type": "number",
          "minimum": 0
        },
        "brain_7d_shuttle3_pct_id_g": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
