{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/bispecific_assessment/cellular_mechanism.request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "case_type",
    "candidate_ids",
    "objective",
    "datasets",
    "decision_protocol",
    "budget",
    "knowledge_cutoff"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "const": "bispecific_cellular_mechanism_assessment"
    },
    "case_type": {
      "const": "evidence_assessment"
    },
    "candidate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classifier_manifest",
        "image_predictions",
        "independent_annotations",
        "condition_metadata"
      ],
      "properties": {
        "classifier_manifest": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_predictions": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "independent_annotations": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "condition_metadata": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decision_protocol": {
      "anyOf": [
        {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/budget"
    },
    "knowledge_cutoff": {
      "type": "string",
      "format": "date"
    }
  },
  "title": "bispecific_cellular_mechanism_assessment input data contract"
}
