{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/monoclonal_target_only/result.schema.json",
  "title": "Target-only monoclonal declared results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "design_mode",
    "sequence_scope",
    "run_id",
    "run_status",
    "requested_count",
    "stop_reason",
    "missing_requirements",
    "records",
    "shortlist",
    "assay_records",
    "provenance",
    "resources",
    "candidate_origins"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "const": "mab_target_only_design"
    },
    "design_mode": {
      "const": "de_novo"
    },
    "sequence_scope": {
      "enum": [
        "variable_domains",
        "Fab_chains",
        "full_length_chains"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "run_status": {
      "enum": [
        "NEEDS_INPUT",
        "PROTOCOL_REQUIRED",
        "BLOCKED",
        "QUALIFIED",
        "PARTIAL",
        "NO_QUALIFYING_DESIGNS",
        "INCOMPLETE",
        "CANCELLED"
      ]
    },
    "requested_count": {
      "type": "integer",
      "minimum": 1
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "missing_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "records": {
      "type": "array",
      "minItems": 0,
      "items": {
        "allOf": [
          {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/pairedRecord"
          },
          {
            "properties": {
              "role": {
                "const": "candidate"
              },
              "parent_id": {
                "type": "null"
              }
            }
          }
        ]
      }
    },
    "shortlist": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "assay_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "candidate_id",
          "path",
          "sha256"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/runProvenance"
    },
    "resources": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/resources"
    },
    "candidate_origins": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "origin",
          "source"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
          },
          "origin": {
            "enum": [
              "generated",
              "retrieved",
              "supplied_library"
            ]
          },
          "source": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
          }
        }
      }
    }
  }
}
