{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/monoclonal_target_only/request.schema.json",
  "title": "Target-only paired-chain monoclonal discovery request",
  "description": "Data contract only; no generation, scoring, or scientifically qualified protocol is supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "design_mode",
    "target",
    "antibody",
    "objective",
    "constraints",
    "evaluation",
    "budget",
    "knowledge_cutoff",
    "discovery"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "const": "mab_target_only_design"
    },
    "design_mode": {
      "const": "de_novo"
    },
    "target": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/target"
    },
    "antibody": {
      "$ref": "#/$defs/antibody"
    },
    "objective": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/objective"
    },
    "constraints": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/constraints"
    },
    "evaluation": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/evaluation"
    },
    "budget": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/budget"
    },
    "knowledge_cutoff": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_origin",
        "framework_policy",
        "source_artifacts",
        "novelty_definition",
        "comparison_policy"
      ],
      "properties": {
        "candidate_origin": {
          "enum": [
            "generated",
            "retrieved",
            "supplied_library"
          ]
        },
        "framework_policy": {
          "type": "string",
          "minLength": 1
        },
        "source_artifacts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
          }
        },
        "novelty_definition": {
          "type": "string",
          "minLength": 1
        },
        "comparison_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "antibody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sequence_scope",
        "reference",
        "desired_isotype",
        "light_chain_type",
        "fc_policy"
      ],
      "properties": {
        "format": {
          "enum": [
            "full_length_IgG",
            "Fab",
            "F(ab')2"
          ]
        },
        "sequence_scope": {
          "enum": [
            "variable_domains",
            "Fab_chains",
            "full_length_chains"
          ]
        },
        "format_details": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "type": "null"
        },
        "desired_isotype": {
          "type": [
            "string",
            "null"
          ]
        },
        "light_chain_type": {
          "enum": [
            "kappa",
            "lambda",
            "not_applicable",
            "unknown"
          ]
        },
        "fc_policy": {
          "enum": [
            "wild_type",
            "effector_enhanced",
            "effector_silenced",
            "half_life_modified",
            "not_applicable",
            "to_be_decided"
          ]
        }
      }
    }
  }
}
