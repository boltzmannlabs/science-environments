{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monoclonal antibody assay evidence record",
  "description": "Provenance record for historical or externally generated assay data. This environment does not execute wet-lab assays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "candidate_id",
    "candidate_sequence_sha256",
    "target_construct_id",
    "target_sequence_sha256",
    "assay_type",
    "endpoint",
    "result_state",
    "value",
    "lower_bound",
    "upper_bound",
    "units",
    "replicate_count",
    "reason",
    "conditions",
    "controls",
    "source",
    "raw_data"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "candidate_sequence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target_construct_id": {"type": "string", "minLength": 1},
    "target_sequence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assay_type": {
      "enum": [
        "direct_binding",
        "kinetic_binding",
        "competition",
        "cell_binding",
        "functional_potency",
        "neutralization",
        "effector_function",
        "internalization",
        "expression",
        "aggregation",
        "solubility",
        "stability",
        "other"
      ]
    },
    "endpoint": {
      "enum": [
        "kd",
        "kon",
        "koff",
        "elisa_ec50",
        "functional_ic50",
        "functional_ec50",
        "neutralization_ic50",
        "adcc",
        "adcp",
        "cdc",
        "internalization_fraction",
        "expression_yield",
        "monomer_fraction",
        "solubility",
        "thermal_transition",
        "other"
      ]
    },
    "result_state": {"enum": ["measured", "below_limit", "above_limit", "interval", "not_measured", "uninterpretable"]},
    "value": {"type": ["number", "null"]},
    "lower_bound": {"type": ["number", "null"]},
    "upper_bound": {"type": ["number", "null"]},
    "units": {"type": "string", "minLength": 1},
    "uncertainty": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "value", "lower_bound", "upper_bound", "units"],
      "properties": {
        "kind": {"enum": ["standard_deviation", "standard_error", "confidence_interval", "credible_interval", "range", "other"]},
        "value": {"type": ["number", "null"]},
        "lower_bound": {"type": ["number", "null"]},
        "upper_bound": {"type": ["number", "null"]},
        "units": {"type": "string", "minLength": 1}
      }
    },
    "replicate_count": {"type": "integer", "minimum": 0},
    "reason": {"type": ["string", "null"]},
    "measured_on": {"type": ["string", "null"], "format": "date"},
    "assay_protocol": {"type": ["string", "null"]},
    "conditions": {
      "type": "object",
      "description": "Assay-specific context such as assay geometry, target presentation, cell or particle context, buffer, temperature, pH, concentration, and instrument; record only applicable values.",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "role"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "source": {"$ref": "#/$defs/artifact"},
    "raw_data": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "allOf": [
    {
      "if": {"properties": {"result_state": {"const": "measured"}}, "required": ["result_state"]},
      "then": {"properties": {"value": {"type": "number"}, "replicate_count": {"minimum": 1}}}
    },
    {
      "if": {"properties": {"result_state": {"const": "interval"}}, "required": ["result_state"]},
      "then": {"properties": {"value": {"type": "null"}, "lower_bound": {"type": "number"}, "upper_bound": {"type": "number"}}}
    },
    {
      "if": {"properties": {"result_state": {"enum": ["below_limit", "above_limit"]}}, "required": ["result_state"]},
      "then": {"properties": {"value": {"type": "null"}, "lower_bound": {"type": ["number", "null"]}, "upper_bound": {"type": ["number", "null"]}}}
    },
    {
      "if": {"properties": {"result_state": {"enum": ["not_measured", "uninterpretable"]}}, "required": ["result_state"]},
      "then": {"properties": {"value": {"type": "null"}, "replicate_count": {"const": 0}}}
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
