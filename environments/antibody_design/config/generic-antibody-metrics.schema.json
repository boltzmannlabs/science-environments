{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target-agnostic monoclonal antibody result metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "design_mode",
    "sequence_scope",
    "run_id",
    "run_status",
    "requested_count",
    "stop_reason",
    "missing_requirements",
    "records",
    "shortlist",
    "assay_records",
    "provenance",
    "resources"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
    "design_mode": {"enum": ["de_novo", "reference_guided", "affinity_maturation", "humanization", "developability_optimization", "specificity_optimization", "mechanism_optimization"]},
    "sequence_scope": {"enum": ["variable_domains", "Fab_chains", "full_length_chains"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "run_status": {"enum": ["NEEDS_INPUT", "PROTOCOL_REQUIRED", "BLOCKED", "QUALIFIED", "PARTIAL", "NO_QUALIFYING_DESIGNS", "INCOMPLETE", "CANCELLED"]},
    "requested_count": {"type": "integer", "minimum": 1},
    "stop_reason": {"type": "string", "minLength": 1},
    "missing_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "shortlist": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}, "uniqueItems": true},
    "assay_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "candidate_id", "path", "sha256"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_sha256", "protocol_sha256", "scientific_execution", "synthetic_fixture", "knowledge_cutoff"],
      "properties": {
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "protocol_sha256": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{64}$"}, {"type": "null"}]},
        "scientific_execution": {"type": "boolean"},
        "synthetic_fixture": {"type": "boolean"},
        "knowledge_cutoff": {"type": "string", "format": "date"},
        "agent_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agent_id", "model_provider", "model_id", "model_revision", "harness_revision", "task_prompt_sha256", "system_prompt_sha256", "enabled_tools_sha256", "execution_backend", "environment_digest", "workspace_id", "workspace_isolated", "random_seed"],
          "properties": {
            "agent_id": {"type": "string", "minLength": 1},
            "model_provider": {"type": "string", "minLength": 1},
            "model_id": {"type": "string", "minLength": 1},
            "model_revision": {"type": "string", "minLength": 1},
            "harness_revision": {"type": "string", "minLength": 1},
            "task_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "system_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "enabled_tools_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "execution_backend": {"enum": ["docker", "singularity", "modal", "daytona", "vercel_sandbox", "ssh", "local", "other"]},
            "environment_digest": {"type": ["string", "null"]},
            "workspace_id": {"type": "string", "minLength": 1},
            "workspace_isolated": {"type": "boolean"},
            "random_seed": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_minutes", "cpu_core_hours", "gpu_hours", "remote_cost_units"],
      "properties": {
        "wall_time_minutes": {"type": "number", "minimum": 0},
        "cpu_core_hours": {"type": "number", "minimum": 0},
        "gpu_hours": {"type": "number", "minimum": 0},
        "remote_cost_units": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "value", "state", "method_id", "units", "scale", "scope", "sequence_sha256", "evidence", "reason"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "value": {"type": ["number", "null"]},
        "state": {"enum": ["PASS", "FAIL", "UNRESOLVED"]},
        "method_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "units": {"type": "string", "minLength": 1},
        "scale": {"type": "string", "minLength": 1},
        "scope": {"enum": ["antibody", "antigen_antibody"]},
        "sequence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "reason": {"type": ["string", "null"]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "role", "parent_id", "sequences", "sequence_sha256", "rules"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "role": {"enum": ["reference", "candidate"]},
        "parent_id": {"anyOf": [{"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}, {"type": "null"}]},
        "sequences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heavy", "light"],
          "properties": {
            "heavy": {"type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"},
            "light": {"type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"}
          }
        },
        "sequence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rules": {"type": "array", "items": {"$ref": "#/$defs/measurement"}}
      }
    }
  }
}
