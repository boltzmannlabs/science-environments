{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json",
  "title": "Shared antibody environment data definitions",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type",
        "source"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/digest"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "name",
        "organism",
        "sequence",
        "constructs",
        "epitope_policy"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "organism": {
          "type": "string",
          "minLength": 1
        },
        "accession": {
          "type": [
            "string",
            "null"
          ]
        },
        "sequence": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        "constructs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/targetConstruct"
          }
        },
        "epitope_policy": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/epitopePolicy"
        },
        "variant_panel": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "targetConstruct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "construct_id",
        "sequence",
        "presentation_context",
        "chain_ids",
        "residue_mapping",
        "post_translational_modifications"
      ],
      "properties": {
        "construct_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        "structures": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
          }
        },
        "presentation_context": {
          "enum": [
            "soluble",
            "cell_surface",
            "viral_particle",
            "multimeric_complex",
            "matrix_associated",
            "other",
            "unknown"
          ]
        },
        "context_details": {
          "type": "string"
        },
        "oligomeric_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "chain_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "residue_mapping": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "post_translational_modifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "site",
              "state"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "site": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "present",
                  "absent",
                  "heterogeneous",
                  "unknown"
                ]
              },
              "evidence": {
                "anyOf": [
                  {
                    "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "native_state_evidence": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "epitopePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "residues",
        "evidence"
      ],
      "properties": {
        "mode": {
          "enum": [
            "defined_residues",
            "defined_region",
            "open_search",
            "unknown"
          ]
        },
        "residues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "excluded_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessibility_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "referenceAntibody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "antibody_id",
        "heavy_sequence",
        "light_sequence",
        "species_origin",
        "numbering_scheme",
        "region_annotations"
      ],
      "properties": {
        "antibody_id": {
          "type": "string",
          "minLength": 1
        },
        "heavy_sequence": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        "light_sequence": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        "heavy_chain_id": {
          "type": "string",
          "minLength": 1
        },
        "light_chain_id": {
          "type": "string",
          "minLength": 1
        },
        "species_origin": {
          "type": "string",
          "minLength": 1
        },
        "isotype": {
          "type": [
            "string",
            "null"
          ]
        },
        "numbering_scheme": {
          "type": "string",
          "minLength": 1
        },
        "region_annotations": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
        },
        "structure": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "known_binding_evidence": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
          }
        },
        "parentage_note": {
          "type": "string"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "desired_effect",
        "specificity_scope"
      ],
      "properties": {
        "mechanism": {
          "enum": [
            "binding_only",
            "antagonism",
            "agonism",
            "ligand_blockade",
            "receptor_blockade",
            "enzyme_inhibition",
            "allosteric_modulation",
            "neutralization",
            "adcc",
            "adcp",
            "cdc",
            "depletion",
            "internalization",
            "payload_delivery",
            "other"
          ]
        },
        "desired_effect": {
          "type": "string",
          "minLength": 1
        },
        "specificity_scope": {
          "type": "string",
          "minLength": 1
        },
        "functional_assays": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cross_reactivity_panel": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preserve_heavy_light_pairing",
        "framework_policy",
        "editable_regions",
        "max_candidates"
      ],
      "properties": {
        "preserve_heavy_light_pairing": {
          "const": true
        },
        "framework_policy": {
          "enum": [
            "preserve",
            "allow_scoped_changes",
            "redesign_variable_domains"
          ]
        },
        "numbering_scheme": {
          "type": "string",
          "minLength": 1
        },
        "editable_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain",
              "region"
            ],
            "properties": {
              "chain": {
                "enum": [
                  "heavy",
                  "light"
                ]
              },
              "region": {
                "enum": [
                  "CDR1",
                  "CDR2",
                  "CDR3",
                  "framework",
                  "custom"
                ]
              },
              "residues": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "max_mutations_per_chain": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "require_unique_paired_sequences": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "required_evidence_domains",
        "requested_count",
        "seed"
      ],
      "properties": {
        "protocol": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "requested_count": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "required_evidence_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "framework",
              "structure",
              "interface",
              "binding",
              "function",
              "specificity",
              "developability",
              "immunogenicity"
            ]
          }
        },
        "blind_reference_outcomes_until_freeze": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_minutes",
        "cpu_hours",
        "gpu_hours"
      ],
      "properties": {
        "wall_time_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "gpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "remote_cost_limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "value",
        "state",
        "method_id",
        "units",
        "scale",
        "scope",
        "sequence_sha256",
        "evidence",
        "reason"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED"
          ]
        },
        "method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "antibody",
            "antigen_antibody"
          ]
        },
        "sequence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/evidenceArtifact"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pairedRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "role",
        "parent_id",
        "sequences",
        "sequence_sha256",
        "rules"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "role": {
          "enum": [
            "reference",
            "candidate"
          ]
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heavy",
            "light"
          ],
          "properties": {
            "heavy": {
              "type": "string",
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
            },
            "light": {
              "type": "string",
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
            }
          }
        },
        "sequence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/measurement"
          }
        }
      }
    },
    "runProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "protocol_sha256",
        "scientific_execution",
        "synthetic_fixture",
        "knowledge_cutoff"
      ],
      "properties": {
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "protocol_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "scientific_execution": {
          "type": "boolean"
        },
        "synthetic_fixture": {
          "type": "boolean"
        },
        "knowledge_cutoff": {
          "type": "string",
          "format": "date"
        },
        "agent_run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_id",
            "model_provider",
            "model_id",
            "model_revision",
            "harness_revision",
            "task_prompt_sha256",
            "system_prompt_sha256",
            "enabled_tools_sha256",
            "execution_backend",
            "environment_digest",
            "workspace_id",
            "workspace_isolated",
            "random_seed"
          ],
          "properties": {
            "agent_id": {
              "type": "string",
              "minLength": 1
            },
            "model_provider": {
              "type": "string",
              "minLength": 1
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "model_revision": {
              "type": "string",
              "minLength": 1
            },
            "harness_revision": {
              "type": "string",
              "minLength": 1
            },
            "task_prompt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "system_prompt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "enabled_tools_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "execution_backend": {
              "enum": [
                "docker",
                "singularity",
                "modal",
                "daytona",
                "vercel_sandbox",
                "ssh",
                "local",
                "other"
              ]
            },
            "environment_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "workspace_id": {
              "type": "string",
              "minLength": 1
            },
            "workspace_isolated": {
              "type": "boolean"
            },
            "random_seed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_minutes",
        "cpu_core_hours",
        "gpu_hours",
        "remote_cost_units"
      ],
      "properties": {
        "wall_time_minutes": {
          "type": "number",
          "minimum": 0
        },
        "cpu_core_hours": {
          "type": "number",
          "minimum": 0
        },
        "gpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "remote_cost_units": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
