{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/monoclonal_reference/request.schema.json",
  "title": "Target-agnostic monoclonal antibody design request",
  "description": "Reference-required request contract for paired-chain monoclonal antibody design or assessment against a specified antigen. The DENV task has its own frozen task-specific request contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "design_mode",
    "target",
    "antibody",
    "objective",
    "constraints",
    "evaluation",
    "budget",
    "knowledge_cutoff"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"
    },
    "design_mode": {
      "enum": [
        "reference_guided",
        "affinity_maturation",
        "humanization",
        "developability_optimization",
        "specificity_optimization",
        "mechanism_optimization"
      ]
    },
    "target": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/target"
    },
    "antibody": {
      "$ref": "#/$defs/antibody"
    },
    "objective": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/objective"
    },
    "constraints": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/constraints"
    },
    "evaluation": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/evaluation"
    },
    "budget": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/budget"
    },
    "knowledge_cutoff": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "antibody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sequence_scope",
        "reference",
        "desired_isotype",
        "light_chain_type",
        "fc_policy"
      ],
      "properties": {
        "format": {
          "enum": [
            "full_length_IgG",
            "Fab",
            "F(ab')2"
          ]
        },
        "sequence_scope": {
          "enum": [
            "variable_domains",
            "Fab_chains",
            "full_length_chains"
          ]
        },
        "format_details": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference": {
          "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/referenceAntibody"
        },
        "desired_isotype": {
          "type": [
            "string",
            "null"
          ]
        },
        "light_chain_type": {
          "enum": [
            "kappa",
            "lambda",
            "not_applicable",
            "unknown"
          ]
        },
        "fc_policy": {
          "enum": [
            "wild_type",
            "effector_enhanced",
            "effector_silenced",
            "half_life_modified",
            "not_applicable",
            "to_be_decided"
          ]
        }
      }
    }
  }
}
