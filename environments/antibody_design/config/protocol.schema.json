{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen monoclonal antibody evaluation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "task_id",
    "status",
    "evaluator_revision",
    "knowledge_cutoff",
    "rules",
    "methods",
    "qualification_evidence",
    "ranking"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"
    },
    "status": {
      "enum": [
        "draft",
        "qualified",
        "deprecated"
      ]
    },
    "evaluator_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "knowledge_cutoff": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 1
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      },
      "minItems": 1
    },
    "qualification_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 0
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_rule_ids",
        "tie_break"
      ],
      "properties": {
        "ordered_rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tie_break": {
          "const": "candidate_id_ascending"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "group",
        "required",
        "metric_id",
        "units",
        "scale",
        "scope",
        "method_id",
        "operator",
        "threshold"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "group": {
          "enum": [
            "identity",
            "framework",
            "fold",
            "interface",
            "binding",
            "function",
            "specificity",
            "stability",
            "aggregation",
            "solubility",
            "expression",
            "polyreactivity",
            "immunogenicity",
            "dynamics",
            "developability"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "metric_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": [
            "antibody",
            "antigen_antibody"
          ]
        },
        "method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "operator": {
          "enum": [
            "ge",
            "le",
            "eq"
          ]
        },
        "threshold": {
          "type": "number"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "name",
        "capability",
        "revision",
        "released_on",
        "availability_evidence",
        "adapter_verified",
        "model_weights",
        "dataset_snapshots"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "released_on": {
          "type": "string",
          "format": "date"
        },
        "availability_evidence": {
          "$ref": "#/$defs/artifact"
        },
        "adapter_verified": {
          "type": "boolean"
        },
        "model_weights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 0
        },
        "dataset_snapshots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 0
        }
      }
    }
  }
}
