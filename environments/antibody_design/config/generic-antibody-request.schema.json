{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target-agnostic monoclonal antibody design request",
  "description": "Reusable request contract for a monoclonal antibody design or optimization task against a specified antigen. The DENV task has its own frozen task-specific request contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "design_mode",
    "target",
    "antibody",
    "objective",
    "constraints",
    "evaluation",
    "budget",
    "knowledge_cutoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
    "design_mode": {
      "enum": ["de_novo", "reference_guided", "affinity_maturation", "humanization", "developability_optimization", "specificity_optimization", "mechanism_optimization"]
    },
    "target": {"$ref": "#/$defs/target"},
    "antibody": {"$ref": "#/$defs/antibody"},
    "objective": {"$ref": "#/$defs/objective"},
    "constraints": {"$ref": "#/$defs/constraints"},
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "budget": {"$ref": "#/$defs/budget"},
    "knowledge_cutoff": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"design_mode": {"enum": ["reference_guided", "affinity_maturation", "humanization", "developability_optimization", "specificity_optimization", "mechanism_optimization"]}},
        "required": ["design_mode"]
      },
      "then": {
        "properties": {"antibody": {"properties": {"reference": {"$ref": "#/$defs/referenceAntibody"}}}}
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "media_type", "source"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "media_type": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "name", "organism", "sequence", "constructs", "epitope_policy"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "organism": {"type": "string", "minLength": 1},
        "accession": {"type": ["string", "null"]},
        "sequence": {"$ref": "#/$defs/artifact"},
        "constructs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/targetConstruct"}
        },
        "epitope_policy": {"$ref": "#/$defs/epitopePolicy"},
        "variant_panel": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "targetConstruct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construct_id", "sequence", "presentation_context", "chain_ids", "residue_mapping", "post_translational_modifications"],
      "properties": {
        "construct_id": {"type": "string", "minLength": 1},
        "sequence": {"$ref": "#/$defs/artifact"},
        "structures": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "presentation_context": {
          "enum": ["soluble", "cell_surface", "viral_particle", "multimeric_complex", "matrix_associated", "other", "unknown"]
        },
        "context_details": {"type": "string"},
        "oligomeric_state": {"type": ["string", "null"]},
        "chain_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "residue_mapping": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "post_translational_modifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "site", "state"],
            "properties": {
              "type": {"type": "string", "minLength": 1},
              "site": {"type": "string", "minLength": 1},
              "state": {"enum": ["present", "absent", "heterogeneous", "unknown"]},
              "evidence": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
            }
          }
        },
        "native_state_evidence": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "epitopePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "residues", "evidence"],
      "properties": {
        "mode": {"enum": ["defined_residues", "defined_region", "open_search", "unknown"]},
        "residues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "region": {"type": ["string", "null"]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "excluded_surfaces": {"type": "array", "items": {"type": "string"}},
        "accessibility_requirements": {"type": "array", "items": {"type": "string"}}
      }
    },
    "antibody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sequence_scope", "reference", "desired_isotype", "light_chain_type", "fc_policy"],
      "properties": {
        "format": {"enum": ["full_length_IgG", "Fab", "F(ab')2"]},
        "sequence_scope": {"enum": ["variable_domains", "Fab_chains", "full_length_chains"]},
        "format_details": {"type": ["string", "null"]},
        "reference": {"anyOf": [{"$ref": "#/$defs/referenceAntibody"}, {"type": "null"}]},
        "desired_isotype": {"type": ["string", "null"]},
        "light_chain_type": {"enum": ["kappa", "lambda", "not_applicable", "unknown"]},
        "fc_policy": {"enum": ["wild_type", "effector_enhanced", "effector_silenced", "half_life_modified", "not_applicable", "to_be_decided"]}
      }
    },
    "referenceAntibody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["antibody_id", "heavy_sequence", "light_sequence", "species_origin", "numbering_scheme", "region_annotations"],
      "properties": {
        "antibody_id": {"type": "string", "minLength": 1},
        "heavy_sequence": {"$ref": "#/$defs/artifact"},
        "light_sequence": {"$ref": "#/$defs/artifact"},
        "heavy_chain_id": {"type": "string", "minLength": 1},
        "light_chain_id": {"type": "string", "minLength": 1},
        "species_origin": {"type": "string", "minLength": 1},
        "isotype": {"type": ["string", "null"]},
        "numbering_scheme": {"type": "string", "minLength": 1},
        "region_annotations": {"$ref": "#/$defs/artifact"},
        "structure": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "known_binding_evidence": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "parentage_note": {"type": "string"}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "desired_effect", "specificity_scope"],
      "properties": {
        "mechanism": {"enum": ["binding_only", "antagonism", "agonism", "ligand_blockade", "receptor_blockade", "enzyme_inhibition", "allosteric_modulation", "neutralization", "adcc", "adcp", "cdc", "depletion", "internalization", "payload_delivery", "other"]},
        "desired_effect": {"type": "string", "minLength": 1},
        "specificity_scope": {"type": "string", "minLength": 1},
        "functional_assays": {"type": "array", "items": {"type": "string"}},
        "cross_reactivity_panel": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_heavy_light_pairing", "framework_policy", "editable_regions", "max_candidates"],
      "properties": {
        "preserve_heavy_light_pairing": {"const": true},
        "framework_policy": {"enum": ["preserve", "allow_scoped_changes", "redesign_variable_domains"]},
        "numbering_scheme": {"type": "string", "minLength": 1},
        "editable_regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chain", "region"],
            "properties": {
              "chain": {"enum": ["heavy", "light"]},
              "region": {"enum": ["CDR1", "CDR2", "CDR3", "framework", "custom"]},
              "residues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        },
        "max_mutations_per_chain": {"type": ["integer", "null"], "minimum": 0},
        "max_candidates": {"type": "integer", "minimum": 1},
        "require_unique_paired_sequences": {"type": "boolean", "default": true}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "required_evidence_domains", "requested_count", "seed"],
      "properties": {
        "protocol": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
        "requested_count": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "required_evidence_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["identity", "framework", "structure", "interface", "binding", "function", "specificity", "developability", "immunogenicity"]}
        },
        "blind_reference_outcomes_until_freeze": {"type": "boolean", "default": true}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_minutes", "cpu_hours", "gpu_hours"],
      "properties": {
        "wall_time_minutes": {"type": "integer", "minimum": 1},
        "cpu_hours": {"type": "number", "minimum": 0},
        "gpu_hours": {"type": "number", "minimum": 0},
        "remote_cost_limit": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
