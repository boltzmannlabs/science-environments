{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/bispecific_design/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "design_mode",
    "targets",
    "architecture",
    "mechanism",
    "constraints",
    "evaluation",
    "budget",
    "knowledge_cutoff"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "const": "bispecific_antibody_design"
    },
    "design_mode": {
      "const": "bispecific"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/target"
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_name",
        "chains",
        "arms",
        "assembly_policy",
        "linker_hinge_policy",
        "fc_policy"
      ],
      "properties": {
        "format_name": {
          "type": "string",
          "minLength": 1
        },
        "chains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain_id",
              "role",
              "copies",
              "sequence"
            ],
            "properties": {
              "chain_id": {
                "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "copies": {
                "type": "integer",
                "minimum": 1
              },
              "sequence": {
                "anyOf": [
                  {
                    "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "arms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arm_id",
              "target_id",
              "epitope_id",
              "chain_ids",
              "valency",
              "parental_evidence"
            ],
            "properties": {
              "arm_id": {
                "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
              },
              "target_id": {
                "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
              },
              "epitope_id": {
                "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
              },
              "chain_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                }
              },
              "valency": {
                "type": "integer",
                "minimum": 1
              },
              "parental_evidence": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
                }
              }
            }
          }
        },
        "assembly_policy": {
          "type": "string",
          "minLength": 1
        },
        "linker_hinge_policy": {
          "type": "string",
          "minLength": 1
        },
        "fc_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "simultaneous_engagement",
        "rationale",
        "functional_endpoint"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "simultaneous_engagement": {
          "enum": [
            "required",
            "not_required",
            "unresolved"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "functional_endpoint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_budget",
        "requested_count",
        "allowed_changes",
        "specificity_panel"
      ],
      "properties": {
        "candidate_budget": {
          "type": "integer",
          "minimum": 1
        },
        "requested_count": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_changes": {
          "type": "string",
          "minLength": 1
        },
        "specificity_panel": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "required_evidence_domains",
        "seed"
      ],
      "properties": {
        "protocol": {
          "anyOf": [
            {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_evidence_domains": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "identity",
              "arm_binding",
              "assembly",
              "joint_engagement",
              "function",
              "developability",
              "specificity"
            ]
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budget": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/budget"
    },
    "knowledge_cutoff": {
      "type": "string",
      "format": "date"
    }
  },
  "title": "Bispecific design request: two specificities and explicit assembly"
}
