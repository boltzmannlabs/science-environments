{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.science-environments.local/antibody_design/bispecific_design/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_status",
    "requested_count",
    "records",
    "shortlist",
    "missing_requirements",
    "stop_reason",
    "provenance",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "const": "bispecific_antibody_design"
    },
    "run_status": {
      "enum": [
        "NEEDS_INPUT",
        "PROTOCOL_REQUIRED",
        "BLOCKED",
        "QUALIFIED",
        "PARTIAL",
        "NO_QUALIFYING_DESIGNS",
        "INCOMPLETE",
        "CANCELLED"
      ]
    },
    "requested_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "construct_sha256",
          "chains",
          "arm_assignments",
          "arm_evidence",
          "whole_molecule_evidence",
          "eligibility",
          "reason"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
          },
          "construct_sha256": {
            "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/digest"
          },
          "chains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chain_id",
                "sequence"
              ],
              "properties": {
                "chain_id": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                },
                "sequence": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
                }
              }
            }
          },
          "arm_assignments": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "arm_id",
                "target_id",
                "chain_ids"
              ],
              "properties": {
                "arm_id": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                },
                "target_id": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                },
                "chain_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                  }
                }
              }
            }
          },
          "arm_evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "arm_id",
                "status",
                "evidence"
              ],
              "properties": {
                "arm_id": {
                  "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "UNRESOLVED"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
                  }
                }
              }
            }
          },
          "whole_molecule_evidence": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/artifact"
            }
          },
          "eligibility": {
            "enum": [
              "PASS",
              "FAIL",
              "UNRESOLVED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "shortlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/identifier"
      }
    },
    "missing_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/runProvenance"
    },
    "resources": {
      "$ref": "https://schemas.science-environments.local/antibody_design/shared/definitions.schema.json#/$defs/resources"
    }
  },
  "title": "Bispecific design declared result: identity and evidence envelope"
}
