      "pca_components": 30,
      "spatial_neighbors_graph": 18,
      "spatial_neighbors_validation": 6,
      "leiden_resolution": 0.6,
      "random_seed": 42,
      "selection": "maximize PC silhouette + 0.16*(spatial coherence - size-null) + 0.08*adjacent-resolution ARI - small-domain penalty",
      "marker_test": "Scanpy Wilcoxon one versus rest on log1p counts normalized per 10,000; Benjamini-Hochberg corrected within each domain across genes",
      "marker_effect_size": "Mean log1p(CP10k) in-domain minus out-domain"
    },
