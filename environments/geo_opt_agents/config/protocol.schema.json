{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geo-Opt protocol",
  "type": "object",
  "required": ["method", "basis_set", "charge", "multiplicity", "max_iterations"],
  "properties": {
    "method": {"type": "string", "minLength": 1}, "basis_set": {"type": "string", "minLength": 1},
    "charge": {"type": "integer"}, "multiplicity": {"type": "integer", "minimum": 1},
    "max_iterations": {"type": "integer", "minimum": 1}, "constraints": {"type": "array"}
  },
  "additionalProperties": true
}
