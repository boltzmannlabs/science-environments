{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMO-LUMO protocol",
  "type": "object",
  "required": ["backend", "method", "basis_set", "charge", "multiplicity", "ev_per_hartree"],
  "properties": {
    "backend": {"const": "pyscf"}, "method": {"const": "RHF"},
    "basis_set": {"const": "sto-3g"}, "charge": {"type": "integer"},
    "multiplicity": {"const": 1}, "ev_per_hartree": {"type": "number", "exclusiveMinimum": 0},
    "scf_convergence": {"type": "number", "exclusiveMinimum": 0}, "max_cycle": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
