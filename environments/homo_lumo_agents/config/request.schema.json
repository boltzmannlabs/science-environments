{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOMO-LUMO task request",
  "type": "object",
  "required": ["task_id", "name", "geometry", "charge", "multiplicity", "method", "basis_set"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1},
    "geometry": {"type": "array", "minItems": 1}, "charge": {"type": "integer"},
    "multiplicity": {"const": 1}, "method": {"const": "RHF"}, "basis_set": {"const": "sto-3g"}
  },
  "additionalProperties": true
}
