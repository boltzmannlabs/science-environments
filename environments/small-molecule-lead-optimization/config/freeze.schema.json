{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "stopping_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "candidate_ids",
    "rationale",
    "stopping_reason"
  ],
  "additionalProperties": false
}
