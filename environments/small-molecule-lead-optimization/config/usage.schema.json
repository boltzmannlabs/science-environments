{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "requested",
        "observed",
        "estimated",
        "unknown"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "unit",
    "amount",
    "category",
    "scope",
    "source"
  ],
  "additionalProperties": false
}
