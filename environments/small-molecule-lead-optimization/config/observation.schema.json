{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "form_id": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "predicted",
        "experimental",
        "synthetic"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "qualifier": {
      "type": "string",
      "enum": [
        "=",
        "<",
        ">",
        "<=",
        ">=",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "unknown"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "candidate_id",
    "form_id",
    "endpoint",
    "value",
    "qualifier",
    "status",
    "source"
  ],
  "additionalProperties": false
}
