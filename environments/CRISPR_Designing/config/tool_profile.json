{
  "environment_id": "crispr-base-editing-guide-design",
  "tool_names": {
    "design": "CRISPR Base Editing",
    "efficacy": "CRISPR Base Editing Efficacy Prediction",
    "bystander": "CRISPR Bystander Effect Prediction",
    "off_target_search": "Bowtie"
  },
  "guide_design": {
    "target_regions": "exonic",
    "pam": "NGG",
    "protospacer_length_nt": 20,
    "editing_modes": ["ABE", "CBE"],
    "editing_windows_1_based_pam_distal": {
      "ABE": [4, 5, 6, 7],
      "CBE": [4, 5, 6, 7, 8]
    }
  },
  "prediction_fasta": {
    "sequence_length_nt": 50,
    "layout": {
      "upstream_flank_nt": 19,
      "protospacer_nt": 20,
      "pam_nt": 3,
      "downstream_flank_nt": 8
    },
    "alphabet": "ACGT",
    "allow_gaps": false,
    "allow_ambiguous_bases": false,
    "record_ids_must_be_unique": true
  },
  "bowtie": {
    "maximum_mismatches": 3,
    "exclude_intended_site": true,
    "genome_index_must_match_reference": true
  },
  "notes": [
    "Project, experiment name, organism, reference genome, transcript, cell type and editor selection are provided per run.",
    "Only use editor and organism combinations confirmed to be supported by the connected tools.",
    "Editing windows are tool-profile settings, not universal properties of all base editors."
  ]
}

