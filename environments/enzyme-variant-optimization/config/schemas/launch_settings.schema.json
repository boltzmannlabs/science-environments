{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit native SCI launch settings",
  "type": "object",
  "required": [
    "llm"
  ],
  "properties": {
    "llm": {
      "type": "object",
      "required": [
        "model",
        "provider",
        "reasoning_effort"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_effort": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "goal": {
      "type": "object",
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "budgets": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
