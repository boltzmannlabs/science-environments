{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MD protocol",
  "type": "object",
  "required": ["engine", "integrator", "timestep_fs", "temperature_K", "seed"],
  "properties": {
    "engine": {"type": "string", "minLength": 1},
    "integrator": {"type": "string", "minLength": 1},
    "timestep_fs": {"type": "number", "exclusiveMinimum": 0},
    "temperature_K": {"type": "number", "exclusiveMinimum": 0},
    "pressure_bar": {"type": ["number", "null"]},
    "thermostat": {"type": ["string", "null"]},
    "barostat": {"type": ["string", "null"]},
    "seed": {"type": "integer"}
  },
  "additionalProperties": true
}
