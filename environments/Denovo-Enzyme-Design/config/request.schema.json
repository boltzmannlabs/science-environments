{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Denovo Enzyme Design resolved execution request",
  "description": "The agent resolves a short user request into this contract using explicit requirements, run policy and documented scientific assumptions. The user need not supply every field manually. Validate before candidate dispatch; incomplete preparation drafts are not runnable requests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "reaction", "conditions", "constraints", "execution"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "reaction": {
      "type": "object", "additionalProperties": false,
      "required": ["reactants", "products", "intended_conversion"],
      "properties": {
        "reactants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/molecule"}},
        "products": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/molecule"}},
        "intended_conversion": {"type": "string", "minLength": 1},
        "requested_profile_id": {"type": "string", "minLength": 1}
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "description": "Optional user preference. Omission means resolve_from_evidence, never assume monomer. The resolved profile fixes assembly before generation.",
      "properties": {
        "mode": {"enum": ["resolve_from_evidence", "monomer", "homodimer"]},
        "reference_structure": {"type": "string", "minLength": 1},
        "reference_assembly_id": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {"reference_assembly_id": ["reference_structure"]}
    },
    "conditions": {
      "type": "object", "additionalProperties": false,
      "required": ["pH", "temperature_C", "expression_host", "solvent", "salt_conditions"],
      "properties": {
        "pH": {"type": "number"},
        "temperature_C": {"type": "number", "exclusiveMinimum": -273.15},
        "expression_host": {"type": "string", "minLength": 1},
        "solvent": {"type": "string", "minLength": 1},
        "salt_conditions": {"type": "string", "minLength": 1},
        "protein_concentration_uM": {"type": "number", "exclusiveMinimum": 0, "description": "Concentration in micromolar under the declared basis. Omission is unresolved, not zero; resolve before making a required concentration-dependent claim."},
        "protein_concentration_basis": {"enum": ["subunit_equivalents", "assembled_complexes"], "description": "Total concentration in subunit equivalents, or concentration of assembled complexes. The latter must not be assumed from total protein when assembly populations are unknown."}
      },
      "dependentRequired": {
        "protein_concentration_uM": ["protein_concentration_basis"],
        "protein_concentration_basis": ["protein_concentration_uM"]
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["length", "forbidden_sequence_features", "property_targets"],
      "properties": {
        "length": {
          "description": "Residues per unique protein sequence, not the total residues in an assembled homodimer.",
          "type": "object", "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {"min": {"type": "integer", "minimum": 1}, "max": {"type": "integer", "minimum": 1}}
        },
        "forbidden_sequence_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "property_targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["final_count", "seed", "controller_mode", "max_generated", "max_refinements_per_lineage", "max_chemistry_candidates", "budget"],
      "properties": {
        "final_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of distinct candidate assemblies; two homodimer chains count as one candidate."
        },
        "seed": {"type": "integer", "minimum": 0},
        "controller_mode": {"enum": ["fixed", "rl_inference", "rl_training"]},
        "max_generated": {"type": "integer", "minimum": 1},
        "max_refinements_per_lineage": {"type": "integer", "minimum": 0},
        "max_chemistry_candidates": {"type": "integer", "minimum": 1},
        "budget": {
          "type": "object", "additionalProperties": false,
          "required": ["wall_time_hours", "cpu_core_hours", "gpu_hours"],
          "properties": {
            "wall_time_hours": {"type": "number", "exclusiveMinimum": 0},
            "cpu_core_hours": {"type": "number", "exclusiveMinimum": 0},
            "gpu_hours": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "molecule": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "format", "value", "stoichiometry"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "format": {"enum": ["smiles", "sdf_path", "identifier"]},
        "value": {"type": "string", "minLength": 1},
        "stoichiometry": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["endpoint", "units", "operator", "value", "required"],
      "properties": {
        "endpoint": {"type": "string", "minLength": 1},
        "units": {"type": "string", "minLength": 1},
        "operator": {"enum": ["ge", "le", "eq"]},
        "value": {"type": ["number", "boolean", "string"]},
        "required": {"type": "boolean"}
      }
    }
  }
}
